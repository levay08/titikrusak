# backend/.env.example
# Salin ke .env dan isi nilainya. Jangan commit .env (berisi rahasia).

# Server
PORT=3000

# e.id Verifier API (File 1 Bagian 7.5; diisi pada hari pelaksanaan)
# Base URL e.id Gateway (File 1 Bagian 8.3): sandbox pakai gateway-sandbox.e.id
EID_BASE_URL=https://gateway.e.id
EID_CLIENT_ID=
EID_CLIENT_SECRET=
# Verification Schema per role (hasil langkah ketiga create-eid-vs):
#   EID_VS_ID_WARGA    = skema Member level 1 (email, nama, alamat, nomor telepon — tanpa KTP)
#   EID_VS_ID_OTORITAS = skema KYC e-KTP (identitas penuh/KTP — untuk otoritas)
EID_VS_ID_WARGA=
EID_VS_ID_OTORITAS=

# Disqus SSO
DISQUS_SHORTNAME=
DISQUS_PUBLIC_KEY=
DISQUS_SECRET_KEY=

# Administrator awal
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
